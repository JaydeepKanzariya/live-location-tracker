{
  "name": "@llt/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stack": "vitest run --config vitest.stack.config.ts"
  },
  "dependencies": {
    "@llt/config": "*",
    "@llt/contracts": "*",
    "@llt/kafka": "*",
    "@llt/observability": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.6.0",
    "openid-client": "^6.6.0",
    "pino": "^9.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0",
    "cookie": "^1.0.0"
  },
  "devDependencies": {
    "@testcontainers/redis": "^11.0.0",
    "socket.io-client": "^4.8.1",
    "testcontainers": "^11.0.0",
    "vitest": "^3.1.0"
  }
}
