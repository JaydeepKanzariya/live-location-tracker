# Copy to .env  (cp .env.example .env). Defaults match infra/compose/docker-compose.yml and docker-compose.yml.

# ---------- App ----------
NODE_ENV=development
PORT=3000
# Public URL of the app / gateway. Used to build the OIDC redirect URI: ${APP_BASE_URL}/auth/callback
APP_BASE_URL=http://localhost:3000
# Comma-separated allowed browser origins for Socket.IO handshake & CSRF checks
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Unique per gateway instance. Becomes part of the broadcaster consumer group id (broadcaster-${INSTANCE_ID}).
INSTANCE_ID=gateway-1
# Long random string in production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me
# 32-byte hex key in production to AES-GCM encrypt refresh tokens stored in Redis
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_IDLE_TTL_MS=1800000
SESSION_MAX_AGE_MS=28800000
LOG_LEVEL=info

# ---------- OIDC / OAuth 2.0 ----------
# Local Keycloak (docker compose). For Google use https://accounts.google.com,
# for Auth0 use https://<tenant>.auth0.com/
OIDC_ISSUER_URL=http://localhost:8080/realms/tracker
OIDC_CLIENT_ID=location-tracker
OIDC_CLIENT_SECRET=location-tracker-secret
OIDC_SCOPES=openid profile email
# Allow an http:// issuer (local Keycloak only). Defaults to true outside production.
OIDC_ALLOW_INSECURE=true

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=live-location-tracker
# Client adapter: confluent (@confluentinc/kafka-javascript) or kafkajs (fallback)
KAFKA_DRIVER=confluent
KAFKA_TOPIC=location-updates
KAFKA_PRESENCE_TOPIC=presence-events
KAFKA_LAST_LOCATION_TOPIC=user-last-location
KAFKA_DLQ_TOPIC=location-updates.dlq
KAFKA_TOPIC_PARTITIONS=3
KAFKA_BROADCASTER_GROUP=broadcaster
# Non-negotiable consumer group id for the history DB writer process
KAFKA_DB_WRITER_GROUP=location-db-writer
KAFKA_PRESENCE_GROUP=presence-projector
# Managed Kafka (Confluent Cloud, Aiven, Redpanda Cloud...):
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Location rules ----------
LOCATION_MIN_INTERVAL_MS=1000
LOCATION_HEARTBEAT_MS=15000
LOCATION_STALE_FADE_MS=25000
LOCATION_STALE_AFTER_MS=30000
LOCATION_CLIENT_REMOVE_MS=35000
LOCATION_STALE_SWEEP_MS=5000
LOCATION_MAX_CLOCK_SKEW_MS=60000
LOCATION_DEDUPE_TTL_SEC=300

# ---------- DB / History Writer ----------
# Leave empty in prototype to simulate persistence; required in v1 history-writer
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
HISTORY_FILE=data/location-history.jsonl
DB_BATCH_MAX_SIZE=500
HISTORY_MIN_DISTANCE_M=10
HISTORY_MIN_INTERVAL_MS=30000

# ---------- Observability ----------
OTEL_SERVICE_NAME=live-location-tracker
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Frontend (Vite) ----------
VITE_ENABLE_SIMULATOR=true

# ---------- Simulator ----------
SIM_CENTER_LAT=23.0225
SIM_CENTER_LNG=72.5714
